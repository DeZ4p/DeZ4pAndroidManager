<Window x:Class="DeZ4pAndroidManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeZ4pAndroidManager.ViewModels"
        Title="DeZ4p Android Manager - Developed by DeZ4p | t.me/DeZ4p"
        Height="820" Width="1440"
        MinHeight="600" MinWidth="1100"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.png">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedNav" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Nav Item Style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowRoot"
                                Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock x:Name="Icon"
                                           Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Width="20"
                                           Margin="12,0,0,0"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding IconBrush}"/>

                                <!-- Label -->
                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           Margin="12,0,10,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                <!-- Status indicator (icon only, no text) -->
                                <TextBlock x:Name="StatusIcon"
                                           Grid.Column="2"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                           Text=""
                                           Foreground="Transparent"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover - only when accessible -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding IsLocked}" Value="False"/>
                                    <Condition Binding="{Binding IsModeBlocked}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RowRoot" Property="Background" Value="{Binding HoverBrush}"/>
                            </MultiDataTrigger>

                            <!-- Selected -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="{Binding SelectionBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                            </Trigger>

                            <!-- MODE BLOCKED - orange lock icon -->
                            <DataTrigger Binding="{Binding IsModeBlocked}" Value="True">
                                <Setter TargetName="Icon" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="Normal"/>
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE72E;"/>
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="#F59E0B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </DataTrigger>

                            <!-- DEVICE LOCKED - red lock icon -->
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter TargetName="Icon" Property="Opacity" Value="0.25"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="Normal"/>
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE72E;"/>
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="#EF4444"/>
                                <Setter Property="Cursor" Value="No"/>
                            </DataTrigger>

                            <!-- UNLOCKED - green unlock icon, bright text -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLocked}" Value="False"/>
                                    <Condition Binding="{Binding IsModeBlocked}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="StatusIcon" Property="Text" Value="&#xE785;"/>
                                <Setter TargetName="StatusIcon" Property="Foreground" Value="#34D399"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="300" MaxWidth="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                MinWidth="300"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader" Grid.Row="0" Margin="16,18,16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="9"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#161C30" Offset="0"/>
                                        <GradientStop Color="#0A0C1A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4F8CFF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <TextBlock Text="D" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DeZ4p" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Android Manager" FontSize="10"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border CornerRadius="6" Padding="8,4" Margin="0,12,0,0"
                                Background="{DynamicResource CardHoverBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#34D399" VerticalAlignment="Center"/>
                                <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="NavListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding Source={StaticResource GroupedNav}}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="False"
                         Padding="0,0,0,8"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10" FontWeight="Bold"
                                               Margin="22,14,22,6"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="16,10"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Connected" FontSize="10" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock Text=" DeZ4p" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT + BLUR OVERLAY -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost"
                            Content="{Binding CurrentView}"
                            Background="{DynamicResource BackgroundBrush}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="0" KernelType="Gaussian"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="8" KernelType="Gaussian"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentPageBlocked}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="12" KernelType="Gaussian"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Lock overlay -->
            <Border Panel.ZIndex="100" Background="#66000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="24"
                        Padding="56,48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="560" MaxWidth="700"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Icon with rings -->
                        <Grid HorizontalAlignment="Center">
                            <Ellipse Width="130" Height="130"
                                     Fill="#334F8CFF" Opacity="0.5"/>
                            <Ellipse Width="106" Height="106"
                                     Fill="#4F8CFF" Opacity="0.2"/>
                            <Border Width="86" Height="86" CornerRadius="24"
                                    Background="#4F8CFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EA;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{DynamicResource Lock.Title}"
                                   FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <TextBlock Text="{DynamicResource Lock.Subtitle}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,26"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,26"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="#334F8CFF" VerticalAlignment="Top">
                                <TextBlock Text="1" FontSize="14" FontWeight="Bold"
                                           Foreground="#4F8CFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="4,0,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="{DynamicResource Lock.Step1}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="#334F8CFF" VerticalAlignment="Top">
                                <TextBlock Text="2" FontSize="14" FontWeight="Bold"
                                           Foreground="#4F8CFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="4,0,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="{DynamicResource Lock.Step2}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="#334F8CFF" VerticalAlignment="Top">
                                <TextBlock Text="3" FontSize="14" FontWeight="Bold"
                                           Foreground="#4F8CFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="4,0,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="{DynamicResource Lock.Step3}"/>
                        </Grid>

                        <Border Background="{DynamicResource CardHoverBrush}"
                                CornerRadius="10" Padding="14,10" Margin="0,30,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lock.Footer}"
                                           FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>

<!--  ACCESS GATE - wrong device mode for this page  -->
            <Border Panel.ZIndex="105" Background="#99000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDeviceConnected}" Value="True"/>
                                    <Condition Binding="{Binding IsCurrentPageBlocked}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border Background="{DynamicResource CardBrush}"
                        CornerRadius="20"
                        Padding="48,40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="520" MaxWidth="640"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.65" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Lock icon with orange ring -->
                        <Grid HorizontalAlignment="Center">
                            <Ellipse Width="118" Height="118" Fill="#33F59E0B" Opacity="0.5"/>
                            <Ellipse Width="96" Height="96" Fill="#F59E0B" Opacity="0.18"/>
                            <Border Width="78" Height="78" CornerRadius="20"
                                    Background="#F59E0B"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="38" FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{DynamicResource Access.Title}"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,8"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <TextBlock Text="{Binding CurrentAccessHint}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"
                                   MaxWidth="480"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                        <!-- Current mode chip -->
                        <Border Background="{DynamicResource CardHoverBrush}"
                                CornerRadius="10" Padding="14,10"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="#F59E0B"/>
                                <TextBlock Text="{DynamicResource Access.CurrentMode}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding CurrentModeLabel}"
                                           FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
            <!-- Flash Toast -->
            <Border x:Name="ConnectedToast"
                    Panel.ZIndex="200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Padding="22,14"
                    CornerRadius="14"
                    Visibility="{Binding ShowConnectedFlash, Converter={StaticResource BoolToVis}}"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="-60"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#34D399" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="4" Opacity="0.55" Color="#10B981"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowConnectedFlash}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                             From="-60" To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.45"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                             From="0" To="-40" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="#33FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FlashMessage}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{DynamicResource Toast.Unlocked}"
                                   FontSize="10" Margin="0,1,0,0"
                                   Foreground="#CCFFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>