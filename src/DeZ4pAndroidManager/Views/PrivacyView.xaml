<UserControl x:Class="DeZ4pAndroidManager.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Privacy.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Privacy.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="{Binding LevelBrush}"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Hint}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding LevelBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveReportCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4F8CFF"/>
                    </Button>
                    <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="10,6">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>