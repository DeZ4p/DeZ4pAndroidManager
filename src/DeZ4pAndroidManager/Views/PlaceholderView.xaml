<UserControl x:Class="DeZ4pAndroidManager.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Margin="20">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="84" Foreground="#4F8CFF" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,20,0,8"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding Description}" FontSize="13"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Placeholder.ComingSoon}" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>