<UserControl x:Class="DeZ4pAndroidManager.Views.WirelessAdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Wifi.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Wifi.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding AndroidVersion, StringFormat='Android {0}'}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Version warning -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1"
                Visibility="{Binding HasVersionWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="28" Foreground="#EF4444" Margin="0,0,14,0"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Wifi.VersionWarningTitle}"
                               FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                    <TextBlock Text="{Binding VersionWarning}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full auto -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Visibility="{Binding IsVersionSupported, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Wifi.FullAutoTitle}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Wifi.FullAutoHint}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding FullAutoCommand}"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="16,12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Wifi.FullAutoBtn}" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Manual controls -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- TCP/IP mode -->
                        <TextBlock Text="{DynamicResource Wifi.SectionTcpIp}" FontSize="13" FontWeight="Bold"
                                   Foreground="#4F8CFF" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource Wifi.DeviceIp}" FontSize="11"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBox Text="{Binding DeviceIp, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="10,6" FontSize="13"
                                         Background="{DynamicResource CardHoverBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GetIpCommand}"
                                    Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                                    Padding="14,10" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#22D3EE" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Wifi.GetIp}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Wifi.TcpPort}" FontSize="11"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="10,6" FontSize="13"
                                         Background="{DynamicResource CardHoverBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding EnableTcpIpCommand}"
                                    Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                                    Padding="14,10"
                                    IsEnabled="{Binding CanEnableTcpIp}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Wifi.EnableTcpIp}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ConnectCommand}"
                                    Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                    Padding="14,10"
                                    IsEnabled="{Binding CanConnect}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Wifi.Connect}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>

                        <!-- Pairing (Android 11+) -->
                        <TextBlock Text="{DynamicResource Wifi.SectionPairing}" FontSize="13" FontWeight="Bold"
                                   Foreground="#A855F7" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Wifi.PairingHint}" FontSize="11"
                                   Margin="0,0,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Wifi.PairPort}" FontSize="11"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBox Text="{Binding PairPort, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="10,6" FontSize="13"
                                         Background="{DynamicResource CardHoverBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Wifi.PairCode}" FontSize="11"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBox Text="{Binding PairCode, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="10,6" FontSize="13"
                                         Background="{DynamicResource CardHoverBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         CaretBrush="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding PairCommand}"
                                Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                                Padding="14,10" Margin="0,0,0,14"
                                IsEnabled="{Binding CanPair}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Wifi.PairBtn}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>

                        <!-- Paired devices -->
                        <TextBlock Text="{DynamicResource Wifi.SectionPaired}" FontSize="13" FontWeight="Bold"
                                   Foreground="#22D3EE" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding PairedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: status + log -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Wifi.SectionStatus}"
                               FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                            Padding="12" Margin="0,0,0,14">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>

                    <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="8,4"
                                    BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="LOG" FontSize="9" FontWeight="Bold"
                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                    <Button Command="{Binding ClearLogCommand}"
                                            HorizontalAlignment="Right"
                                            Tag="#6B7280" Style="{StaticResource ActionBarButton}"
                                            Padding="6,3">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="#6B7280"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                                <TextBlock Text="{Binding LogText}" FontSize="10.5"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="#22D3EE"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>