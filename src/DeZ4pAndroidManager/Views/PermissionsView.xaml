<UserControl x:Class="DeZ4pAndroidManager.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Perms.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Perms.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource Perms.Apps}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding PackageName}" FontSize="10" Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#33EF4444" CornerRadius="3"
                                            Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DangerousDisplay}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#EF4444"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding SelectedApp.PackageName}" FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Perms.Granted}" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,8" Foreground="#34D399"/>
                            <ItemsControl ItemsSource="{Binding SelectedApp.GrantedPermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2234D399" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                            <Grid>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                                        Padding="8,4" HorizontalAlignment="Right">
                                                    <TextBlock Text="Revoke" FontSize="10" Foreground="#EF4444"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Perms.Denied}" FontSize="11" FontWeight="Bold"
                                       Margin="0,16,0,8" Foreground="#EF4444"/>
                            <ItemsControl ItemsSource="{Binding SelectedApp.DeniedPermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22EF4444" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                            <Grid>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Command="{Binding DataContext.GrantCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                                        Padding="8,4" HorizontalAlignment="Right">
                                                    <TextBlock Text="Grant" FontSize="10" Foreground="#34D399"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveReportCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4F8CFF"/>
                    </Button>
                    <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="10,6">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>