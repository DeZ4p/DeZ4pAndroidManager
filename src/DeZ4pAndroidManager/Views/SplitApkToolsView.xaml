<UserControl x:Class="DeZ4pAndroidManager.Views.SplitApkToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnFileDrop"
             DragOver="OnDragOver"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource SplitTools.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource SplitTools.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <!-- Mode selector -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <Button Command="{Binding SetModeCommand}" CommandParameter="analyze"
                        Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                        Padding="14,8" Margin="0,0,6,0"
                        Opacity="{Binding IsAnalyzeMode, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#4F8CFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.ModeAnalyze}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetModeCommand}" CommandParameter="pack"
                        Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                        Padding="14,8" Margin="0,0,6,0"
                        Opacity="{Binding IsPackMode, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.ModePack}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetModeCommand}" CommandParameter="unpack"
                        Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                        Padding="14,8" Margin="0,0,6,0"
                        Opacity="{Binding IsUnpackMode, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#22D3EE" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.ModeUnpack}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetModeCommand}" CommandParameter="install"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="14,8"
                        Opacity="{Binding IsInstallMode, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.ModeInstall}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Source picker -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="12,8" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="{DynamicResource SplitTools.SourceHint}"
                                   FontSize="12" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SourcePath}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SourcePath}" FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Command="{Binding BrowseFileCommand}"
                        Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                        Padding="12,8" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.PickFile}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding BrowseFolderCommand}"
                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                        Padding="12,8" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.PickFolder}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Command="{Binding ClearSourceCommand}"
                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                        Padding="10,8"
                        IsEnabled="{Binding HasSource}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#EF4444"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#4F8CFF"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource SplitTools.SplitsHeader}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SetSplitCount}"
                                       FontSize="11" Margin="10,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border Background="#CC000000"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                Panel.ZIndex="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="#4F8CFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SplitTools.Analyzing}"
                                           FontSize="12" Margin="0,10,0,0"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ListView x:Name="SplitListView"
                                  ItemsSource="{Binding Splits}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource ForegroundBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource SplitTools.ColType}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="8,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding TypeColor}" Opacity="0.22"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding TypeBadgeLabel}" FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TypeBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{DynamicResource SplitTools.ColName}" Width="320" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="{DynamicResource SplitTools.ColLabel}" Width="130" DisplayMemberBinding="{Binding TypeLabel}"/>
                                    <GridViewColumn Header="{DynamicResource SplitTools.ColSize}" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                    <GridViewColumn Header="{DynamicResource SplitTools.ColDetails}" Width="280" DisplayMemberBinding="{Binding DetailsDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#34D399"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource SplitTools.InfoHeader}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                    Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SetName}" FontSize="14" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding SetSourceKind}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SplitTools.InfoTotalSize}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SetTotalSize}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SplitTools.InfoSplits}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SetSplitCount}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SplitTools.InfoArch}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SetArchSummary}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource SplitTools.InfoLang}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SetLangSummary}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Text="{DynamicResource SplitTools.InfoDpi}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SetDensitySummary}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0"
                                        Visibility="{Binding HasSet, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="42" Opacity="0.4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SplitTools.NoSource}"
                                           FontSize="12" Margin="0,12,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsPackMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource SplitTools.OutputApks}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                            CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding OutputPath}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding BrowseOutputFolderCommand}"
                                            Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                                            Padding="10,6">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#22D3EE"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsUnpackMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource SplitTools.OutputFolder}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                            CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding OutputPath}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding BrowseOutputFolderCommand}"
                                            Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                                            Padding="10,6">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#22D3EE"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsInstallMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource SplitTools.TargetDevice}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Height="34"
                                              ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}"
                                            Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                            Padding="10,7">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#34D399"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <ProgressBar Height="6" Margin="0,0,0,8"
                                         Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                         Background="{DynamicResource CardHoverBrush}"
                                         BorderThickness="0" Foreground="#4F8CFF"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- PRIMARY BUTTON — direct Click handler -->
                                <Button x:Name="PrimaryActionButton"
                                        Grid.Column="0"
                                        Click="OnPrimaryActionClick"
                                        Padding="14,9" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionBarButton}">
                                            <Setter Property="Tag" Value="#4F8CFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPackMode}" Value="True">
                                                    <Setter Property="Tag" Value="#A855F7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUnpackMode}" Value="True">
                                                    <Setter Property="Tag" Value="#22D3EE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstallMode}" Value="True">
                                                    <Setter Property="Tag" Value="#34D399"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PrimaryActionIcon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{Binding PrimaryActionBrush}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PrimaryActionLabel}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                        Padding="12,9"
                                        IsEnabled="{Binding IsBusy}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#4F8CFF"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <Button Command="{Binding OpenOutputCommand}"
                        HorizontalAlignment="Right"
                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                        Padding="10,6"
                        IsEnabled="{Binding HasOutput}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplitTools.OpenOutput}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>