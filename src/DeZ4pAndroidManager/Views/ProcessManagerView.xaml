<UserControl x:Class="DeZ4pAndroidManager.Views.ProcessManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Proc.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Proc.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="10,7" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12" Margin="22,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Proc.UserFilter}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <ComboBox Width="130" Height="32" Margin="0,0,10,0"
                              ItemsSource="{Binding UserFilterOptions}"
                              SelectedItem="{Binding FilterUser}"/>
                </StackPanel>

                <CheckBox Grid.Column="2" IsChecked="{Binding ShowSystemProcesses}"
                          Content="{DynamicResource Proc.ShowSystem}" FontSize="12"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource ForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- Process list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Border Background="#CC000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="10" CornerRadius="3">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="#22D3EE" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Proc.Loading}"
                                   FontSize="12" Margin="0,8,0,0"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListView x:Name="ProcessListView"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                            <GridViewColumn Header="PPID" Width="70" DisplayMemberBinding="{Binding Ppid}"/>
                            <GridViewColumn Header="USER" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding User}" FontWeight="SemiBold"
                                                   Foreground="{Binding UserColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="S" Width="30" DisplayMemberBinding="{Binding State}"/>
                            <GridViewColumn Header="RSS" Width="90" DisplayMemberBinding="{Binding RssDisplay}"/>
                            <GridViewColumn Header="VSZ" Width="90" DisplayMemberBinding="{Binding VszDisplay}"/>
                            <GridViewColumn Header="NAME" Width="500" DisplayMemberBinding="{Binding Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Bottom actions + status -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding ForceStopCommand}"
                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                        Padding="14,8" Margin="0,0,6,0"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Proc.ForceStop}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Command="{Binding KillCommand}"
                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                        Padding="14,8" Margin="0,0,6,0"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Proc.Kill}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding CopyInfoCommand}"
                        Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                        Padding="14,8"
                        IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7"/>
                </Button>

                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" FontSize="11.5"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                <TextBlock Grid.Column="4" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}">
                    <Run Text="{Binding Processes.Count, Mode=OneWay}"/>
                    <Run Text="process(es)"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>