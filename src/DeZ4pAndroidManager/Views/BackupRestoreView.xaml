<UserControl x:Class="DeZ4pAndroidManager.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource BackupRestore.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource BackupRestore.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="240" Height="34"/>
                <Button Command="{Binding RefreshDevicesCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#34D399"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab switcher -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <Button Command="{Binding SetTabCommand}" CommandParameter="backup"
                        Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                        Padding="18,10" Margin="0,0,6,0"
                        Opacity="{Binding IsBackupTab, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#4F8CFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BackupRestore.TabBackup}" VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetTabCommand}" CommandParameter="restore"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="18,10"
                        Opacity="{Binding IsRestoreTab, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BackupRestore.TabRestore}" VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- BACKUP TAB -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding IsBackupTab, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Output folder -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BackupRestore.OutputFolder}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                        CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding BackupFolder}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Border>
                                <Button Grid.Column="1" Command="{Binding BrowseBackupFolderCommand}"
                                        Tag="#4F8CFF" Style="{StaticResource ActionBarButton}" Padding="10,6"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenBackupFolderCommand}"
                                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}" Padding="10,6">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Categories -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding BackupCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                            Padding="12" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                                    Background="{Binding Color}" Opacity="0.18"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" Foreground="{Binding Color}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding StatusNote}" FontSize="10" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding StatusNote, Converter={StaticResource StringNotEmptyToVis}}"/>
                                            </StackPanel>

                                            <ProgressBar Grid.Column="3" Width="100" Height="6"
                                                         Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{Binding Color}"
                                                         VerticalAlignment="Center" Margin="10,0,10,0"/>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="100">
                                                <TextBlock Text="{Binding ItemCountDisplay}" FontSize="11"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding BytesDisplay}" FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Backup button -->
                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding StartBackupCommand}"
                                    Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                                    Padding="16,10" IsEnabled="{Binding HasDevice}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#4F8CFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BackupRestore.StartBackup}"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding CancelCommand}"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="12,10" IsEnabled="{Binding IsBusy}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RESTORE TAB -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding IsRestoreTab, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Backup folder picker -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BackupRestore.RestoreFrom}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                        CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding RestoreFolder}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Border>
                                <Button Grid.Column="1" Command="{Binding BrowseRestoreFolderCommand}"
                                        Tag="#34D399" Style="{StaticResource ActionBarButton}" Padding="10,6"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#34D399"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding OpenRestoreFolderCommand}"
                                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}" Padding="10,6">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding ManifestInfo}" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding RestoreCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                                Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                                        Background="{Binding Color}" Opacity="0.18"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="16" Foreground="{Binding Color}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding StatusNote}" FontSize="10" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ProgressBar Grid.Column="3" Width="100" Height="6"
                                                             Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{Binding Color}"
                                                             VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasManifest, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="42" Opacity="0.35"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BackupRestore.NoBackupLoaded}"
                                           FontSize="12" Margin="0,12,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding StartRestoreCommand}"
                                    Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                    Padding="16,10"
                                    IsEnabled="{Binding HasDevice}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource BackupRestore.StartRestore}"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding CancelCommand}"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="12,10" IsEnabled="{Binding IsBusy}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- HISTORY PANEL -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="#F59E0B"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BackupRestore.History}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClearHistoryCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding DeviceName}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding InfoDisplay}" FontSize="10" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <TextBlock Text="{Binding CreatedDisplay}" FontSize="9.5" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FolderPath}"
                                                    Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                                                    Padding="8,6" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="#F59E0B"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom status + overall progress -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" Foreground="#4F8CFF"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding CurrentNote}" FontSize="10" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="180" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" FontSize="11"
                               HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <ProgressBar Height="6" Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100"
                                 Background="{DynamicResource CardHoverBrush}" BorderThickness="0"
                                 Foreground="#4F8CFF" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>