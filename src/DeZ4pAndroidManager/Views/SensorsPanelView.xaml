<UserControl x:Class="DeZ4pAndroidManager.Views.SensorsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Sensors.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Sensors.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="10,7" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12" Margin="22,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Command="{Binding LoadRawCommand}"
                        Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                        Padding="12,7" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#22D3EE" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Sensors.LoadRaw}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding SaveRawCommand}"
                        Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                        Padding="10,7" Margin="0,0,6,0"
                        IsEnabled="{Binding HasRawDump}">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>

                <Button Grid.Column="3" Command="{Binding CopyRawCommand}"
                        Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                        Padding="10,7"
                        IsEnabled="{Binding HasRawDump}">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Sensors list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Border Background="#CC000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="10" CornerRadius="3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="#22D3EE" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Sensors.Loading}"
                                       FontSize="12" Margin="0,8,0,0"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="SensorListView"
                              ItemsSource="{Binding Sensors}"
                              SelectedItem="{Binding SelectedSensor}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18" Foreground="{Binding TypeColor}"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Vendor" Width="140" DisplayMemberBinding="{Binding Vendor}"/>
                                <GridViewColumn Header="Type" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeShort}" FontWeight="SemiBold"
                                                       Foreground="{Binding TypeColor}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type ID" Width="80" DisplayMemberBinding="{Binding TypeId}"/>
                                <GridViewColumn Header="Version" Width="70" DisplayMemberBinding="{Binding Version}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#34D399"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Sensors.DetailsHeader}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CopySensorCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5"
                                    IsEnabled="{Binding HasSensorDetails}">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#A855F7"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasSensorDetails, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedSensor.Name}" FontSize="14" FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                        Padding="12" Margin="0,12,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Vendor}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.Vendor}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Type}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.TypeName}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       TextWrapping="Wrap" MaxWidth="200"
                                                       Foreground="{Binding SelectedSensor.TypeColor}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Version}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.Version}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Handle}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.Handle, StringFormat=0x{0:X8}}" FontSize="12"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.MaxRange}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.MaxRange}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Resolution}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.Resolution}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.Power}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.Power}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Sensors.MinDelay}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.MinDelay}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Sensors.FifoMax}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SelectedSensor.FifoMax}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- No selection -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0"
                                        Visibility="{Binding HasSensorDetails, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="42" Opacity="0.35"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Sensors.NoSelection}"
                                           FontSize="12" Margin="0,12,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>