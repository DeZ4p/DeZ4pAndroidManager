<UserControl x:Class="DeZ4pAndroidManager.Views.LogcatViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Logcat.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Logcat.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding CountDisplay}" FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshDevicesCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding StartCommand}"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="14,7" Margin="0,0,6,0"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolToBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Logcat.Start}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Command="{Binding StopCommand}"
                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                        Padding="14,7" Margin="0,0,6,0"
                        IsEnabled="{Binding IsRunning}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Logcat.Stop}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding PauseCommand}"
                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                        Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Logcat.Pause}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="3" Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="10,6" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12" Margin="22,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="4" Width="130" Height="32" Margin="0,0,6,0"
                          ItemsSource="{Binding LevelOptions}"
                          SelectedItem="{Binding SelectedLevel}"
                          ToolTip="Minimum level"/>

                <ComboBox Grid.Column="5" Width="180" Height="32" Margin="0,0,10,0"
                          ItemsSource="{Binding PresetOptions}"
                          SelectedItem="{Binding SelectedPreset}"
                          ToolTip="Preset filter"/>

                <CheckBox Grid.Column="6" IsChecked="{Binding AutoScroll}"
                          Content="Auto-scroll" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="{DynamicResource ForegroundBrush}"/>

                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button Command="{Binding ClearCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="0,0,6,0"
                            ToolTip="Clear">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B"/>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="0,0,6,0"
                            ToolTip="Save">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                    </Button>
                    <Button Command="{Binding CopyCommand}" Tag="#A855F7"
                            Style="{StaticResource ActionBarButton}" Padding="10,7"
                            ToolTip="Copy">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Padding="12,8" Margin="0,0,0,8"
                Background="{DynamicResource CardHoverBrush}" CornerRadius="3">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#6B7280"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="#34D399"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Logcat.MaxLines}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- Log list -->
        <Border Grid.Row="3" Background="#0A0A0A" CornerRadius="6">
            <ScrollViewer x:Name="LogScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <ListView ItemsSource="{Binding FilteredEntries}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          FontFamily="Consolas">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                  Content="{TemplateBinding Content}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding TimeDisplay}"/>
                            <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding PidDisplay}"/>
                            <GridViewColumn Header="Lvl" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" FontWeight="Bold"
                                                   Foreground="{Binding LevelColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tag" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag}" FontWeight="SemiBold"
                                                   Foreground="{Binding TagColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Message" Width="900">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="NoWrap"
                                                   Foreground="{Binding MsgColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>