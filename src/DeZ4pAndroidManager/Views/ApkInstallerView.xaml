<UserControl x:Class="DeZ4pAndroidManager.Views.ApkInstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnFileDrop"
             DragOver="OnDragOver">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource Apk.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Apk.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <!-- Device picker -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <Border Width="36" Height="36" CornerRadius="10" Background="#334F8CFF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="#4F8CFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource Apk.TargetDevice}" VerticalAlignment="Center"
                           FontSize="13" Margin="0,0,10,0"/>
                <ComboBox Width="320" Height="36"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"/>
                <Button Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource GhostButton}" Margin="10,0,0,0" FlowDirection="LeftToRight">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BrowseCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" FlowDirection="LeftToRight">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Apk.BrowsePackage}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Drop zone -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2" CornerRadius="12"
                Padding="20" Margin="0,0,0,14" MinHeight="140">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="20"
                        Background="#3334D399" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                               FontSize="34" Foreground="#34D399"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding ApkFileName}"
                           FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{DynamicResource Apk.DragHint}"
                           FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Apk.DragHint2}"
                           FontSize="10" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Install Log -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,10">
                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Apk.InstallLog}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding InstallLog}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ForegroundBrush}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <Button Command="{Binding InstallCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Padding="22,12" FontSize="14"
                    FlowDirection="LeftToRight">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Apk.InstallPackage}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>