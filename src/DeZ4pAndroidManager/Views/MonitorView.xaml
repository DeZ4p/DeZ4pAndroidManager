<UserControl x:Class="DeZ4pAndroidManager.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:DeZ4pAndroidManager.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <Grid Margin="24" MinHeight="820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Live Monitor" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Real-time CPU, memory and network activity from your device."
                               Style="{StaticResource PageSubtitle}" Margin="0"/>
                </StackPanel>
            </Grid>

            <!-- ═══ Controls ═══ -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Device:" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
                        <ComboBox Width="320" Height="34"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"/>
                        <Button Content="🔄" Command="{Binding RefreshDevicesCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                        <Button Content="▶  Start" Command="{Binding StartCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/>
                        <Button Content="■  Stop" Command="{Binding StopCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Grid>
            </Border>

            <!-- ═══ Live numbers ═══ -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                <Border Background="{DynamicResource BatteryCardBrush}"
                        BorderBrush="{DynamicResource BatteryBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="0,0,6,0" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔥" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#34D399"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuDisplay}" FontSize="26" FontWeight="Bold"
                                   Foreground="#34D399"/>
                        <TextBlock Text="{Binding LoadDisplay, StringFormat='load avg: {0}'}"
                                   FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource MemoryCardBrush}"
                        BorderBrush="{DynamicResource MemoryBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="6,0,6,0" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#A855F7"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RamDisplay}" FontSize="26" FontWeight="Bold"
                                   Foreground="#A855F7"/>
                        <TextBlock Text="{Binding RamDetail}" FontSize="10"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource NetworkCardBrush}"
                        BorderBrush="{DynamicResource NetworkBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="6,0,6,0" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⬆" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#22D3EE"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NetUpDisplay}" FontSize="20" FontWeight="Bold"
                                   Foreground="#22D3EE"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource NetworkCardBrush}"
                        BorderBrush="{DynamicResource NetworkBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="6,0,0,0" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⬇" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Download" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#22D3EE"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NetDownDisplay}" FontSize="20" FontWeight="Bold"
                                   Foreground="#22D3EE"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ Charts ═══ -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CPU + RAM charts side by side -->
                <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,14">
                    <Border Background="{DynamicResource BatteryCardBrush}"
                            BorderBrush="{DynamicResource BatteryBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,12,14,6">
                                <TextBlock Text="🔥" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="CPU Usage" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#34D399"/>
                                <TextBlock Text="60s" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <ctrl:Sparkline Height="110" Margin="14,0,14,14"
                                            Values="{Binding CpuHistory}"
                                            MaxValue="100"
                                            StrokeBrush="#34D399"
                                            StrokeColor="#34D399"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource MemoryCardBrush}"
                            BorderBrush="{DynamicResource MemoryBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,12,14,6">
                                <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="RAM Usage" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#A855F7"/>
                                <TextBlock Text="60s" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <ctrl:Sparkline Height="110" Margin="14,0,14,14"
                                            Values="{Binding RamHistory}"
                                            MaxValue="100"
                                            StrokeBrush="#A855F7"
                                            StrokeColor="#A855F7"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Network charts -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
                    <Border Background="{DynamicResource NetworkCardBrush}"
                            BorderBrush="{DynamicResource NetworkBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,12,14,6">
                                <TextBlock Text="⬆" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Upload Speed" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#22D3EE"/>
                                <TextBlock Text="60s" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <ctrl:Sparkline Height="90" Margin="14,0,14,14"
                                            Values="{Binding NetUpHistory}"
                                            MaxValue="0" AutoScale="True"
                                            StrokeBrush="#22D3EE"
                                            StrokeColor="#22D3EE"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource NetworkCardBrush}"
                            BorderBrush="{DynamicResource NetworkBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,12,14,6">
                                <TextBlock Text="⬇" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Download Speed" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#22D3EE"/>
                                <TextBlock Text="60s" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <ctrl:Sparkline Height="90" Margin="14,0,14,14"
                                            Values="{Binding NetDownHistory}"
                                            MaxValue="0" AutoScale="True"
                                            StrokeBrush="#22D3EE"
                                            StrokeColor="#22D3EE"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>