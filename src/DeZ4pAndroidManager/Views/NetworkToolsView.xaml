<UserControl x:Class="DeZ4pAndroidManager.Views.NetworkToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource NetTools.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource NetTools.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
                <Button Command="{Binding PingCommand}" Tag="#22D3EE"
                        Style="{StaticResource ActionBarButton}" Padding="12,7" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#22D3EE" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ping" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- WiFi card -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets"
                                   FontSize="34" Foreground="#22D3EE" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Info.WifiSsid}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding Info.WifiIp}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Info.RssiDisplay}" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="#34D399"/>
                            <TextBlock Text="{Binding Info.RssiQuality}" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detail cards -->
                <UniformGrid Columns="3">
                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="6" Padding="14" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NetTools.WifiMac}" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding Info.WifiMac}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,0" FontFamily="Consolas"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="6" Padding="14" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NetTools.Link}" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding Info.LinkSpeedDisplay}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="6" Padding="14" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NetTools.Freq}" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding Info.FrequencyDisplay}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Mobile / DNS -->
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,5,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="#A855F7" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource NetTools.Mobile}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource NetTools.Operator}" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Info.MobileOperator}" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{DynamicResource NetTools.Network}" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Info.MobileNetworkType}" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="5,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="#4F8CFF" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource NetTools.Dns}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="DNS 1" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Info.Dns1}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="DNS 2" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Info.Dns2}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{DynamicResource NetTools.Gateway}" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Info.DefaultGateway}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Interfaces -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{DynamicResource NetTools.Interfaces}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding Info.Interfaces}"
                                  Background="Transparent" BorderThickness="0" MaxHeight="240"
                                  Foreground="{DynamicResource ForegroundBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Interface" Width="130" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="State" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding State}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="IP" Width="180" DisplayMemberBinding="{Binding Ip}"/>
                                    <GridViewColumn Header="MAC" Width="180" DisplayMemberBinding="{Binding Mac}"/>
                                    <GridViewColumn Header="MTU" Width="70" DisplayMemberBinding="{Binding Mtu}"/>
                                    <GridViewColumn Header="RX" Width="110" DisplayMemberBinding="{Binding RxDisplay}"/>
                                    <GridViewColumn Header="TX" Width="110" DisplayMemberBinding="{Binding TxDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveReportCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource NetTools.Save}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="10,6">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>