<UserControl x:Class="DeZ4pAndroidManager.Views.AdbConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource AdbConsole.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource AdbConsole.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshDevicesCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Command input -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4F8CFF" CornerRadius="3"
                        Padding="10,7" Margin="0,0,6,0" VerticalAlignment="Stretch">
                    <TextBlock Text="adb shell" FontFamily="Consolas" FontSize="12"
                               Foreground="White" VerticalAlignment="Center"/>
                </Border>

                <TextBox Grid.Column="1" x:Name="CommandBox"
                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13"
                         Height="34" Padding="10,6" Margin="0,0,6,0"
                         Background="{DynamicResource CardHoverBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         CaretBrush="{DynamicResource ForegroundBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         KeyDown="OnCommandKeyDown"/>

                <Button Grid.Column="2" Command="{Binding RunCommand}"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="14,7" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AdbConsole.Run}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Command="{Binding CopyOutputCommand}"
                        Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                        Padding="10,7" Margin="0,0,6,0" ToolTip="Copy all output">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#A855F7"/>
                </Button>
                <Button Grid.Column="4" Command="{Binding SaveOutputCommand}"
                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                        Padding="10,7" ToolTip="Save output">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Output -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#4F8CFF"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource AdbConsole.OutputHeader}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="10.5"
                                           Margin="14,0,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClearOutputCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="0,0,3,3">
                        <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#4B5563" VerticalAlignment="Top"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Prefix}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding PrefixColor}"
                                                       VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                       FontFamily="Consolas" FontSize="11.5"
                                                       Foreground="{Binding TextColor}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Presets -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#A855F7"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource AdbConsole.PresetsHeader}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClearHistoryCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5" ToolTip="Clear history">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding AllPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.UsePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ActionBarButton}"
                                            Tag="#4F8CFF" Padding="10,7" Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding Category}" FontSize="9.5" Margin="0,1,0,0"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="#4F8CFF"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>