<UserControl x:Class="DeZ4pAndroidManager.Views.ApkBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Backup.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Backup.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <!-- Output folder + mode + search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Output folder -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Command="{Binding BrowseFolderCommand}"
                            Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Backup.Folder}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Command="{Binding SetModeCommand}" CommandParameter="apk"
                            Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                            Padding="10,7" Margin="0,0,4,0"
                            Opacity="{Binding IsModeApk, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{DynamicResource Backup.ModeApk}" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Button>
                    <Button Command="{Binding SetModeCommand}" CommandParameter="apks"
                            Tag="#A855F7" Style="{StaticResource ActionBarButton}"
                            Padding="10,7" Margin="0,0,4,0"
                            Opacity="{Binding IsModeApks, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{DynamicResource Backup.ModeApks}" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Button>
                    <Button Command="{Binding SetModeCommand}" CommandParameter="apk+obb"
                            Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                            Padding="10,7"
                            Opacity="{Binding IsModeObb, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="{DynamicResource Backup.ModeObb}" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="10,6" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13" Margin="24,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <CheckBox Grid.Column="3"
                          IsChecked="{Binding ShowSystemApps}"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          FlowDirection="LeftToRight"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <TextBlock Text="{DynamicResource AppsManager.ShowSystem}" FontSize="12"
                               VerticalAlignment="Center"/>
                </CheckBox>

                <Button Grid.Column="4"
                        Command="{Binding RefreshCommand}"
                        Tag="#34D399" Style="{StaticResource ActionBarButton}"
                        Padding="10,7">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#34D399"/>
                </Button>
            </Grid>
        </Border>

        <!-- Apps + History -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Apps -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Border Background="#CC000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="10" CornerRadius="3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="#4F8CFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource AppsManager.Loading}"
                                       FontSize="12" Margin="0,10,0,0"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="AppListView"
                              ItemsSource="{Binding FilteredApps}"
                              SelectionMode="Extended"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ForegroundBrush}"
                              SelectionChanged="OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{Binding IconColor}"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource AppsManager.ColName}" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="{DynamicResource AppsManager.ColPackage}" Width="320" DisplayMemberBinding="{Binding PackageName}"/>
                                <GridViewColumn Header="{DynamicResource AppsManager.ColVersion}" Width="110" DisplayMemberBinding="{Binding VersionDisplay}"/>
                                <GridViewColumn Header="{DynamicResource AppsManager.ColType}" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="8,2"
                                                    Background="#22A855F7" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TypeColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- History -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="#F59E0B"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Backup.History}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClearHistoryCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding History}" Margin="8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}"
                                            CornerRadius="3" Padding="10,8" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding PackageName}"
                                                           FontSize="10" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusColor}"/>
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding SizeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding ApkCountDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                                                    Padding="8,5" VerticalAlignment="Center"
                                                    Visibility="{Binding Status, Converter={StaticResource StatusToVis}}">
                                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="#4F8CFF"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#4F8CFF"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentAppName}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CountDisplay}"
                               HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Height="6" Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100"
                             Background="{DynamicResource CardHoverBrush}" BorderThickness="0"
                             Foreground="#4F8CFF" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Bottom action bar -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">

                <Button Command="{Binding BackupSelectedCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Backup.BackupSelected}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding BackupAllCommand}" Tag="#22D3EE"
                        Style="{StaticResource ActionBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#22D3EE" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Backup.BackupAll}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CancelCommand}" Tag="#EF4444"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.Cancel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2,10,2"/>

                <Button Command="{Binding CopyToDeviceCommand}" Tag="#A855F7"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Backup.CopyToDevice}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                        Style="{StaticResource ActionBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Backup.OpenFolder}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>