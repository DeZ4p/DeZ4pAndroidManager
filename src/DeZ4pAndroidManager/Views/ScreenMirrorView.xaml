<UserControl x:Class="DeZ4pAndroidManager.Views.ScreenMirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Mirror.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Mirror.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding ScrcpyStatus}" FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{Binding ScrcpyStatusColor}"/>
                <Button Command="{Binding CheckScrcpyCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,6" Margin="0,0,6,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4F8CFF"/>
                </Button>
                <Button Command="{Binding OpenScrcpyFolderCommand}" Tag="#F59E0B"
                        Style="{StaticResource ActionBarButton}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Mirror.ScrcpyFolder}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Device row -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Mirror.Device}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <ComboBox Grid.Column="1" Height="34" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Margin="0,0,10,0"/>

                <Button Grid.Column="2" Command="{Binding RefreshDevicesCommand}" Tag="#22D3EE"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="0,0,6,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#22D3EE"/>
                </Button>

                <Button Grid.Column="3" Command="{Binding StopCommand}"
                        Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                        Padding="14,9" IsEnabled="{Binding IsRunning}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Mirror.Stop}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Options -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource Mirror.SectionVideo}" FontSize="13" FontWeight="Bold"
                                   Foreground="#4F8CFF" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Mirror.MaxSize}" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="34" ItemsSource="{Binding ResolutionPresets}"
                                          SelectedValue="{Binding MaxSize}" SelectedValuePath="Value"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Mirror.Fps}" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="34" ItemsSource="{Binding FpsPresets}"
                                          SelectedValue="{Binding MaxFps}" SelectedValuePath="Value"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Mirror.Bitrate}" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="1" Maximum="50"
                                            Value="{Binding VideoBitRateMbps}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="11" MinWidth="55"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}">
                                        <Run Text="{Binding VideoBitRateMbps, Mode=OneWay}"/>
                                        <Run Text=" Mbps"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Mirror.Codec}" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="34" ItemsSource="{Binding CodecOptions}"
                                          SelectedItem="{Binding VideoCodec}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                        <TextBlock Text="{DynamicResource Mirror.SectionWindow}" FontSize="13" FontWeight="Bold"
                                   Foreground="#A855F7" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Fullscreen}"
                                      Content="{DynamicResource Mirror.Fullscreen}"
                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                            <CheckBox Grid.Column="2" IsChecked="{Binding AlwaysOnTop}"
                                      Content="{DynamicResource Mirror.AlwaysOnTop}"
                                      Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Mirror.WindowTitle}" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="10,6" FontSize="12"
                                     Background="{DynamicResource CardHoverBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                        <TextBlock Text="{DynamicResource Mirror.SectionBehavior}" FontSize="13" FontWeight="Bold"
                                   Foreground="#34D399" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox IsChecked="{Binding TurnScreenOff}"
                                          Content="{DynamicResource Mirror.TurnOffScreen}"
                                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                          Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding StayAwake}"
                                          Content="{DynamicResource Mirror.StayAwake}"
                                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                          Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding ShowTouches}"
                                          Content="{DynamicResource Mirror.ShowTouches}"
                                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <CheckBox IsChecked="{Binding MuteAudio}"
                                          Content="{DynamicResource Mirror.MuteAudio}"
                                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                          Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding AudioOnly}"
                                          Content="{DynamicResource Mirror.AudioOnly}"
                                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Mirror.Keyboard}" FontSize="11" Margin="0,4,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="30" ItemsSource="{Binding KeyboardOptions}"
                                          SelectedItem="{Binding KeyboardMode}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                        <TextBlock Text="{DynamicResource Mirror.SectionRecording}" FontSize="13" FontWeight="Bold"
                                   Foreground="#EC4899" Margin="0,0,0,10"/>

                        <CheckBox IsChecked="{Binding Record}"
                                  Content="{DynamicResource Mirror.RecordTo}"
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="12"
                                  Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                    CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                                <TextBlock Text="{Binding RecordPath}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding BrowseRecordPathCommand}"
                                    Tag="#EC4899" Style="{StaticResource ActionBarButton}"
                                    Padding="10,6" Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Mirror.BrowseFile}">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#EC4899"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding OpenRecordFolderCommand}"
                                    Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                                    Padding="10,6"
                                    ToolTip="{DynamicResource Mirror.OpenFolder}">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B"/>
                            </Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Status + Start -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource Mirror.SectionStatus}" FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Height="140" CornerRadius="6"
                                Background="#0A0A0A" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="56" Foreground="#22D3EE"
                                           HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="{DynamicResource Mirror.Hint}" FontSize="10"
                                           Margin="0,10,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ⭐ ALWAYS enabled Start button -->
                        <Button Grid.Row="1" Command="{Binding StartCommand}"
                                Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                Padding="16,12" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#34D399" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Mirror.Start}" FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="8,4"
                                        BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="LOG" FontSize="9" FontWeight="Bold"
                                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <Button Command="{Binding ClearLogCommand}"
                                                HorizontalAlignment="Right"
                                                Tag="#6B7280" Style="{StaticResource ActionBarButton}"
                                                Padding="6,3">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="#6B7280"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10"
                                              x:Name="LogScroll">
                                    <TextBlock Text="{Binding LogText}"
                                               FontSize="10.5"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"
                                               Foreground="#34D399"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" Foreground="#4F8CFF"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>