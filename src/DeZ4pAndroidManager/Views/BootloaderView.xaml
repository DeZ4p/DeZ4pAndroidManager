<UserControl x:Class="DeZ4pAndroidManager.Views.BootloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Boot.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Boot.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
                <Button Command="{Binding SaveReportCommand}" Tag="#A855F7"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                Visibility="{Binding IsFastboot, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Boot.NoFastboot}" FontSize="11.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="18"
                        Background="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding StateBrush}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Boot.State}" FontSize="10"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding CurrentState}" FontSize="24" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{Binding StateBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Unlock Ability" FontSize="10"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding UnlockAbility}" FontSize="14" FontWeight="SemiBold"
                               Margin="0,4,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
                <Button Grid.Column="3" Command="{Binding RefreshStateCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#4F8CFF" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Boot.Refresh}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Command="{Binding GetAbilityCommand}" Tag="#22D3EE"
                            Style="{StaticResource ActionBarButton}" Padding="18,16" Margin="0,0,5,0"
                            HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#22D3EE" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Boot.GetAbility}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Boot.GetAbilityHint}" FontSize="10.5" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeviceInfoCommand}" Tag="#A855F7"
                            Style="{StaticResource ActionBarButton}" Padding="18,16" Margin="5,0,0,0"
                            HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#A855F7" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Boot.DeviceInfo}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Boot.DeviceInfoHint}" FontSize="10.5" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Boot.DangerousTitle}" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#EF4444" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2">
                            <Button Command="{Binding UnlockCommand}" Tag="#EF4444"
                                    Style="{StaticResource ActionBarButton}" Padding="16,12" Margin="0,0,5,0"
                                    HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#EF4444" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Boot.Unlock}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Boot.UnlockHint}" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LockCommand}" Tag="#34D399"
                                    Style="{StaticResource ActionBarButton}" Padding="16,12" Margin="5,0,0,0"
                                    HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#34D399" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Boot.Lock}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Boot.LockHint}" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OemUnlockCommand}" Tag="#F97316"
                                    Style="{StaticResource ActionBarButton}" Padding="16,12" Margin="0,5,5,0"
                                    HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#F97316" Margin="0,0,8,0"/>
                                        <TextBlock Text="OEM Unlock" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Boot.OemUnlockHint}" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OemLockCommand}" Tag="#818CF8"
                                    Style="{StaticResource ActionBarButton}" Padding="16,12" Margin="5,5,0,0"
                                    HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsFastboot}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#818CF8" Margin="0,0,8,0"/>
                                        <TextBlock Text="OEM Lock" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Boot.OemLockHint}" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding HasDeviceInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Boot.OemInfo}" FontSize="12.5" FontWeight="Bold"
                                   Margin="0,0,0,8" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding DeviceInfo}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Action Log" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                <Button Command="{Binding ClearLogCommand}" HorizontalAlignment="Right"
                                        Tag="#EF4444" Style="{StaticResource ActionBarButton}" Padding="8,5">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" Padding="10">
                            <ItemsControl ItemsSource="{Binding ActionLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                   Margin="0,2" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="10,8">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>