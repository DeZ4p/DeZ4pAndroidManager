<UserControl x:Class="DeZ4pAndroidManager.Views.AppsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource AppsManager.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource AppsManager.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="10,6" Margin="0,0,10,0"
                        FlowDirection="LeftToRight">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Margin="0,0,10,0"
                        Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="6" Padding="10,6">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,0,8,0"/>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Margin="24,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <CheckBox Grid.Column="2"
                          IsChecked="{Binding ShowSystemApps}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          FlowDirection="LeftToRight"
                          Foreground="{DynamicResource ForegroundBrush}">
                    <TextBlock Text="{DynamicResource AppsManager.ShowSystem}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </CheckBox>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- App list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Border Background="#CC000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="10" CornerRadius="3">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="#4F8CFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.Loading}"
                                   FontSize="12" Margin="0,10,0,0"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListView x:Name="AppListView"
                          ItemsSource="{Binding FilteredApps}"
                          SelectionMode="Extended"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource ForegroundBrush}"
                          SelectionChanged="OnSelectionChanged"
                          MouseDoubleClick="OnItemDoubleClick"
                          PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">

                    <ListView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPackageCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding UninstallCommand}"/>
                        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
                        <KeyBinding Key="Return" Command="{Binding LaunchCommand}"/>
                    </ListView.InputBindings>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{Binding IconColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource AppsManager.ColName}" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="{DynamicResource AppsManager.ColPackage}" Width="360" DisplayMemberBinding="{Binding PackageName}"/>
                            <GridViewColumn Header="{DynamicResource AppsManager.ColVersion}" Width="120" DisplayMemberBinding="{Binding VersionDisplay}"/>
                            <GridViewColumn Header="{DynamicResource AppsManager.ColType}" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="8,2"
                                                Background="#22A855F7" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding TypeColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource AppsManager.ColStatus}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- ═══════ Colorful Bottom Action Bar ═══════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">

                <Button Command="{Binding LaunchCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}" ToolTip="Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#4F8CFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.Launch}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ForceStopCommand}" Tag="#F59E0B"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.ForceStop}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearDataCommand}" Tag="#EC4899"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.ClearData}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2,10,2"/>

                <Button Command="{Binding EnableCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.Enable}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DisableCommand}" Tag="#EF4444"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.Disable}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2,10,2"/>

                <Button Command="{Binding ExportApkCommand}" Tag="#22D3EE"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#22D3EE" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.ExportApk}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding UninstallCommand}" Tag="#DC2626"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}" ToolTip="Del">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppsManager.Uninstall}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>