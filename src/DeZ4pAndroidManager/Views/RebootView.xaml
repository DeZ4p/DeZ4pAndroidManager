<UserControl x:Class="DeZ4pAndroidManager.Views.RebootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="24">
            <TextBlock Text="{DynamicResource Reboot.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Reboot.Subtitle}" Style="{StaticResource PageSubtitle}"/>

            <!-- Device picker -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14">
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="22" Foreground="#4F8CFF"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Reboot.TargetDevice}" VerticalAlignment="Center"
                               FontSize="13" Margin="0,0,10,0"/>
                    <ComboBox Width="300" Height="34"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"/>
                    <Button Command="{Binding RefreshDevicesCommand}"
                            Style="{StaticResource GhostButton}" Margin="10,0,0,0" FlowDirection="LeftToRight"
                            Padding="10,8">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ ALL OPTIONS IN ONE ROW ═══ -->
            <UniformGrid Columns="7" Margin="0,0,0,16">

                <!-- 1. Normal Reboot -->
                <Button Command="{Binding RebootCommand}" CommandParameter="normal"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#14B8A6" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.NormalReboot}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 2. Recovery -->
                <Button Command="{Binding RebootCommand}" CommandParameter="recovery"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.RecoveryMode}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 3. Bootloader -->
                <Button Command="{Binding RebootCommand}" CommandParameter="bootloader"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.BootloaderMode}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 4. Fastboot -->
                <Button Command="{Binding RebootCommand}" CommandParameter="fastboot"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#818CF8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.FastbootMode}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 5. Shutdown -->
                <Button Command="{Binding RebootCommand}" CommandParameter="shutdown"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#A855F7" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.ShutdownDevice}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 6. System UI -->
                <Button Command="{Binding RebootCommand}" CommandParameter="systemui"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,6,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#22D3EE" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.SystemUI}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 7. EDL -->
                <Button Command="{Binding RebootCommand}" CommandParameter="edl"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0" Padding="8" Height="100">
                    <StackPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#DC2626" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Reboot.EDLMode}" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>