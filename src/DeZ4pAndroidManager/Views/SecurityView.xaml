<UserControl x:Class="DeZ4pAndroidManager.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Security.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Security.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="150" Height="150">
                    <Ellipse Fill="Transparent" Stroke="{DynamicResource BorderBrush}" StrokeThickness="12" Opacity="0.3"/>
                    <Ellipse Fill="Transparent" Stroke="{Binding ScoreColor}" StrokeThickness="12" StrokeDashArray="1 3"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreDisplay}" FontSize="44" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="{Binding ScoreColor}"/>
                        <TextBlock Text="/ 100" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock Text="{DynamicResource Security.ScoreTitle}" FontSize="13"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding GradeDisplay}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{Binding ScoreColor}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,10,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveReportCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Security.Save}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="10,8">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl ItemsSource="{Binding Report.Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="{Binding LevelBrush}"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" MinWidth="180" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Value}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{Binding LevelBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="11"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <Border Grid.Column="3" CornerRadius="3" Padding="8,3"
                                            Background="{Binding LevelBrush}" Opacity="0.9"
                                            VerticalAlignment="Center" MinWidth="70">
                                        <TextBlock Text="{Binding LevelLabel}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>