<Window x:Class="DeZ4pAndroidManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeZ4p"
        Width="460" Height="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True" Icon="/Assets/AppIcon.png">

    <Border Background="#0F1115"
            BorderBrush="#2A2F3A"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.55"
                              Color="Black"/>
        </Border.Effect>

        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo circle -->
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Ellipse x:Name="LogoRing"
                         Width="88" Height="88"
                         Stroke="#4F8CFF"
                         StrokeThickness="3"
                         Fill="Transparent"
                         Opacity="0.25"/>

                <Ellipse x:Name="SpinnerRing"
                         Width="88" Height="88"
                         StrokeThickness="3"
                         Fill="Transparent">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="44" CenterY="44"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F8CFF" Offset="0"/>
                            <GradientStop Color="#A855F7" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>

                <TextBlock Text="🔥"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           x:Name="LogoFire"/>
            </Grid>

            <!-- Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="DeZ4p Android Manager"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#E8EAED"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="v1.0.0"
                           FontSize="11"
                           Margin="0,4,0,0"
                           Foreground="#9AA0A6"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Loading message -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="Initializing..."
                       FontSize="11"
                       Margin="0,18,0,0"
                       Foreground="#5F6570"
                       HorizontalAlignment="Center"/>

            <!-- Progress bar -->
            <Border Grid.Row="3"
                    Height="3"
                    CornerRadius="2"
                    Margin="0,14,0,0"
                    Background="#1A1D23"
                    ClipToBounds="True">
                <Canvas>
                    <Border x:Name="ProgressSlide"
                            Width="110"
                            Height="3"
                            CornerRadius="2"
                            Canvas.Left="0"
                            Canvas.Top="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#A855F7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</Window>