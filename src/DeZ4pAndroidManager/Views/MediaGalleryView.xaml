<UserControl x:Class="DeZ4pAndroidManager.Views.MediaGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Media.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Media.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,10,0">
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="all" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="12,6" Margin="0,0,6,0"
                            Opacity="{Binding IsAllSelected, Converter={StaticResource BoolToOpacity}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.FilterAll}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="image" Tag="#EC4899"
                            Style="{StaticResource ActionBarButton}" Padding="12,6" Margin="0,0,6,0"
                            Opacity="{Binding IsImageSelected, Converter={StaticResource BoolToOpacity}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#EC4899" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.FilterImages}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="video" Tag="#A855F7"
                            Style="{StaticResource ActionBarButton}" Padding="12,6" Margin="0,0,6,0"
                            Opacity="{Binding IsVideoSelected, Converter={StaticResource BoolToOpacity}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.FilterVideos}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="audio" Tag="#22D3EE"
                            Style="{StaticResource ActionBarButton}" Padding="12,6"
                            Opacity="{Binding IsAudioSelected, Converter={StaticResource BoolToOpacity}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#22D3EE" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.FilterAudio}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}" Padding="10,6" Margin="0,0,10,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#34D399"/>
                </Button>

                <Border Grid.Column="2" Background="{DynamicResource CardHoverBrush}"
                        CornerRadius="3" Padding="10,6" Margin="0,0,10,0">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" Margin="24,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}"
                           FontSize="11" VerticalAlignment="Center" MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- Main: List + Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Border Background="#CC000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="10" CornerRadius="3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="#EC4899" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.Loading}"
                                       FontSize="12" Margin="0,10,0,0"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="MediaListView"
                              ItemsSource="{Binding FilteredItems}"
                              SelectionMode="Extended"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ForegroundBrush}"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnItemDoubleClick">
                        <ListView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                            <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
                            <KeyBinding Key="Return" Command="{Binding PlayCommand}"/>
                        </ListView.InputBindings>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="{Binding IconColor}"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Media.ColName}" Width="280" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="{DynamicResource Media.ColKind}" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="8,2"
                                                    Background="#22EC4899" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindDisplay}" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding IconColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Media.ColSize}" Width="85" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Media.ColDimensions}" Width="110" DisplayMemberBinding="{Binding DimensionsDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Media.ColDate}" Width="135" DisplayMemberBinding="{Binding DateDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- ═══ PREVIEW PANE ═══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#EC4899"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Media.PreviewHeader}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- No selection -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedItem}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="48" Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="{DynamicResource Media.NoPreview}"
                                       FontSize="12" Margin="0,14,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Preview content -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Image preview -->
                            <Border Grid.Row="0" Background="#0A0A0A" MinHeight="240" MaxHeight="380"
                                    Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           Margin="8"/>
                                    <Border Background="#88000000"
                                            Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="26" Foreground="#EC4899"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Media.PreviewLoading}"
                                                       FontSize="11" Margin="0,8,0,0"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Video preview -->
                            <Border Grid.Row="0" Background="#0A0A0A" MinHeight="240" MaxHeight="380"
                                    Visibility="{Binding HasVideoPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="72" Foreground="#A855F7"
                                               HorizontalAlignment="Center" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Media.VideoHint}"
                                               FontSize="11" Margin="0,14,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Audio preview -->
                            <Border Grid.Row="0" Background="#0A0A0A" MinHeight="240" MaxHeight="380"
                                    Visibility="{Binding HasAudioPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="72" Foreground="#22D3EE"
                                               HorizontalAlignment="Center" Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource Media.AudioHint}"
                                               FontSize="11" Margin="0,14,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Other -->
                            <Border Grid.Row="0" Background="#0A0A0A" MinHeight="240" MaxHeight="380"
                                    Visibility="{Binding HasOtherPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewIcon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="72" Foreground="{DynamicResource MutedForegroundBrush}"
                                               HorizontalAlignment="Center" Opacity="0.6"/>
                                    <TextBlock Text="{DynamicResource Media.PreviewNotAvailable}"
                                               FontSize="11" Margin="0,14,0,0"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- File info -->
                            <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                <TextBlock Text="{Binding PreviewName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Media.ColKind}" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="{Binding PreviewKind}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Media.ColSize}" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="{Binding PreviewSize}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Media.ColDimensions}" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="{Binding PreviewDimensions}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Media.ColDate}" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="{Binding PreviewDate}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding PlayCommand}"
                                    Tag="{Binding PrimaryActionColor}"
                                    Style="{StaticResource ActionBarButton}"
                                    Padding="14,9" Margin="0,0,6,0"
                                    IsEnabled="{Binding HasSelectedItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryActionIcon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{Binding PrimaryActionColor}"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryActionLabel}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{Binding OpenWithCommand}"
                                    Tag="#818CF8"
                                    Style="{StaticResource ActionBarButton}"
                                    Padding="12,9"
                                    IsEnabled="{Binding HasSelectedItem}"
                                    ToolTip="{DynamicResource Media.OpenWith}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="#818CF8"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Media.OpenWithShort}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom action bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">

                <Button Command="{Binding PlayCommand}"
                        Tag="{Binding BottomPrimaryColor}"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BottomPrimaryIcon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{Binding BottomPrimaryColor}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BottomPrimaryLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DownloadCommand}" Tag="#22D3EE"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#22D3EE" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Media.Download}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DownloadAllCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Media.DownloadAll}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2,10,2"/>

                <Button Command="{Binding CopyPathCommand}" Tag="#818CF8"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#818CF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Media.CopyPath}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteCommand}" Tag="#EF4444"
                        Style="{StaticResource ActionBarButton}"
                        IsEnabled="{Binding HasSelection}" ToolTip="Del">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Media.Delete}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>