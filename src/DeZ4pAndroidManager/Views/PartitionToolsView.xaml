<UserControl x:Class="DeZ4pAndroidManager.Views.PartitionToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Part.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Part.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}">
                        <Run Text="{Binding PartitionCount, Mode=OneWay}"/>
                        <Run Text=" partitions"/>
                    </TextBlock>
                </Border>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                Visibility="{Binding IsFastboot, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Part.NoFastboot}" FontSize="11.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="10,7">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="12" Margin="22,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="PartListView" ItemsSource="{Binding FilteredPartitions}"
                      SelectedItem="{Binding Selected}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource ForegroundBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Partition" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="140" DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="Type" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left"
                                            Background="{Binding TypeBrush}" Opacity="0.9">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CopyNameCommand}" Tag="#22D3EE"
                            Style="{StaticResource ActionBarButton}" Padding="10,6" Margin="0,0,6,0"
                            IsEnabled="{Binding HasSelected}" ToolTip="Copy name">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#22D3EE"/>
                    </Button>
                    <Button Command="{Binding BackupCommand}" Tag="#A855F7"
                            Style="{StaticResource ActionBarButton}" Padding="14,7" Margin="0,0,6,0"
                            IsEnabled="{Binding HasSelected}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Part.Backup}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportListCommand}" Tag="#4F8CFF"
                            Style="{StaticResource ActionBarButton}" Padding="10,6">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4F8CFF"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>