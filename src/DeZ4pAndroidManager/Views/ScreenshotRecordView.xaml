<UserControl x:Class="DeZ4pAndroidManager.Views.ScreenshotRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource ScrRec.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource ScrRec.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding AndroidVersion, StringFormat='Android {0}'}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshDevicesCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Version warning banner -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1"
                Visibility="{Binding HasVersionWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets"
                           FontSize="28" Foreground="#EF4444" Margin="0,0,14,0"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource ScrRec.VersionWarningTitle}"
                               FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                    <TextBlock Text="{Binding VersionWarning}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Screenshot section -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ScrRec.OutputFolder}" FontSize="11"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}"
                                CornerRadius="3" Padding="10,7" Margin="0,0,6,0">
                            <TextBlock Text="{Binding OutputFolder}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}"
                                Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                                Padding="10,6" Margin="0,0,6,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding OpenFolderCommand}"
                                Tag="#F59E0B" Style="{StaticResource ActionBarButton}" Padding="10,6">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ScrRec.Delay}" FontSize="11"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <ComboBox Height="34" ItemsSource="{Binding DelayOptions}"
                              SelectedValue="{Binding DelaySeconds}" SelectedValuePath="Value"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <CheckBox Grid.Column="2" IsChecked="{Binding SaveAsJpg}"
                          Content="JPG" FontSize="12" VerticalAlignment="Bottom"
                          Margin="0,0,10,8"
                          Foreground="{DynamicResource ForegroundBrush}"/>

                <CheckBox Grid.Column="3" IsChecked="{Binding AutoOpen}"
                          Content="{DynamicResource ScrRec.AutoOpen}" FontSize="12"
                          VerticalAlignment="Bottom" Margin="0,0,10,8"
                          Foreground="{DynamicResource ForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- Main row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Recorder + Recent -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Recorder -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ScrRec.RecordTitle}" FontSize="13"
                                   FontWeight="Bold" Foreground="#EC4899" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource ScrRec.Resolution}" FontSize="10"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="32" ItemsSource="{Binding SizeOptions}"
                                          SelectionChanged="OnSizeSelectionChanged"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource ScrRec.Bitrate}" FontSize="10"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="32" ItemsSource="{Binding BitrateOptions}"
                                          SelectedItem="{Binding RecBitRateMbps}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource ScrRec.TimeLimit}" FontSize="10"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ComboBox Height="32" ItemsSource="{Binding TimeLimitOptions}"
                                          SelectedValue="{Binding RecTimeLimitSec}" SelectedValuePath="Value"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding RecRotate}"
                                      Content="{DynamicResource ScrRec.Rotate}" FontSize="12"
                                      Foreground="{DynamicResource ForegroundBrush}"/>
                            <CheckBox Grid.Column="2" IsChecked="{Binding RecAudio}"
                                      Content="{DynamicResource ScrRec.RecordAudio}" FontSize="12"
                                      Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox Grid.Column="4" Height="32" ItemsSource="{Binding AudioSourceOptions}"
                                      SelectedItem="{Binding RecAudioSource}"
                                      IsEnabled="{Binding RecAudio}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding StartRecordingCommand}"
                                    Tag="#34D399" Style="{StaticResource ActionBarButton}"
                                    Padding="14,10" Margin="0,0,6,0"
                                    IsEnabled="{Binding CanStartRecord}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource ScrRec.StartRecording}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding StopRecordingCommand}"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="14,10"
                                    IsEnabled="{Binding IsRecording}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource ScrRec.StopRecording}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent captures -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="{DynamicResource ScrRec.RecentHeader}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <ItemsControl ItemsSource="{Binding RecentCaptures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                                Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" Foreground="#EC4899"
                                                           Text=""/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                                    <TextBlock Text="{Binding InfoDisplay}" FontSize="10" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding CreatedDisplay}" FontSize="9.5"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Tag="#F59E0B" Style="{StaticResource ActionBarButton}"
                                                        Padding="8,6" VerticalAlignment="Center">
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" Foreground="#F59E0B"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: big screenshot button + log -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource ScrRec.ScreenshotHeader}"
                               FontSize="13" FontWeight="Bold" Foreground="#4F8CFF" Margin="0,0,0,10"/>

                    <Button Grid.Row="1" Command="{Binding TakeScreenshotCommand}"
                            Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                            Padding="20,18" Margin="0,0,0,14"
                            IsEnabled="{Binding IsVersionSupported}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                       Foreground="#4F8CFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource ScrRec.TakeScreenshot}"
                                       FontSize="14" FontWeight="Bold" Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="8,4"
                                    BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="LOG" FontSize="9" FontWeight="Bold"
                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                    <Button Command="{Binding ClearLogCommand}"
                                            HorizontalAlignment="Right"
                                            Tag="#6B7280" Style="{StaticResource ActionBarButton}"
                                            Padding="6,3">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="#6B7280"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                                <TextBlock Text="{Binding LogText}" FontSize="10.5"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="#34D399"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>