<UserControl x:Class="DeZ4pAndroidManager.Views.FlashToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Flash.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Flash.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Slot: " FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <TextBlock Text="{Binding CurrentSlot}" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="#22D3EE"/>
                    </StackPanel>
                </Border>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                Visibility="{Binding IsFastboot, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Flash.NoFastboot}" FontSize="11.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Flash.Partition}" FontSize="10" Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <ComboBox Width="180" Height="34" IsEditable="True"
                              ItemsSource="{Binding CommonPartitions}"
                              Text="{Binding SelectedPartition}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource Flash.Image}" FontSize="10" Margin="0,0,0,4"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="10,7">
                        <TextBlock Text="{Binding ImageName}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding PickImageCommand}" Tag="#A855F7"
                        Style="{StaticResource ActionBarButton}" Padding="12,8" Margin="0,0,6,0"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#A855F7" Margin="0,0,6,0"/>
                        <TextBlock Text="Browse" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{Binding FlashCommand}" Tag="#34D399"
                        Style="{StaticResource ActionBarButton}" Padding="14,8" Margin="0,0,6,0"
                        VerticalAlignment="Bottom" IsEnabled="{Binding IsFastboot}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#34D399" Margin="0,0,6,0"/>
                        <TextBlock Text="Flash" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Command="{Binding WipeCommand}" Tag="#EF4444"
                        Style="{StaticResource ActionBarButton}" Padding="14,8"
                        VerticalAlignment="Bottom" IsEnabled="{Binding IsFastboot}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#EF4444" Margin="0,0,6,0"/>
                        <TextBlock Text="Erase" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Flash.History}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}">
                                    <Run Text="{Binding TotalRuns, Mode=OneWay}"/>
                                    <Run Text="runs"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}" Padding="8,5">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding History}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ForegroundBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Partition" Width="110" DisplayMemberBinding="{Binding Partition}"/>
                                <GridViewColumn Header="Image" Width="200" DisplayMemberBinding="{Binding ImageName}"/>
                                <GridViewColumn Header="Slot" Width="60" DisplayMemberBinding="{Binding Slot}"/>
                                <GridViewColumn Header="Status" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Duration" Width="90" DisplayMemberBinding="{Binding DurationMs, StringFormat={}{0}ms}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Flash.Options}" FontSize="12.5" FontWeight="SemiBold"
                               Margin="0,0,0,12" Foreground="{DynamicResource ForegroundBrush}"/>
                    <CheckBox IsChecked="{Binding FlashBothSlots}" Content="Flash to both slots (A + B)"
                              FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundBrush}"/>
                    <CheckBox IsChecked="{Binding RebootAfter}" Content="Reboot after successful flash"
                              FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundBrush}"/>
                    <CheckBox IsChecked="{Binding SkipVerify}" Content="Skip verification (faster, riskier)"
                              FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundBrush}"/>
                    <CheckBox IsChecked="{Binding AutoAdvance}" Content="Auto-advance slots on error"
                              FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundBrush}"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="✓ " FontSize="14" Foreground="#34D399" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SuccessCount}" FontSize="14" FontWeight="Bold"
                                   Foreground="#34D399"/>
                        <TextBlock Text="  ✗ " FontSize="14" Foreground="#EF4444" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FailCount}" FontSize="14" FontWeight="Bold"
                                   Foreground="#EF4444"/>
                    </StackPanel>

                    <Button Command="{Binding RetryFailedCommand}" Tag="#F59E0B"
                            Style="{StaticResource ActionBarButton}" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#F59E0B" Margin="0,0,6,0"/>
                            <TextBlock Text="Retry Failed" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,10"/>
                    <TextBlock Text="{DynamicResource Flash.Warning}" FontSize="11" TextWrapping="Wrap"
                               LineHeight="18" Foreground="#F59E0B"/>

                    <ProgressBar Height="4" Margin="0,14,0,0"
                                 Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100"
                                 Background="Transparent" BorderThickness="0" Foreground="#34D399"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,10,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFastboot}" Value="True">
                                    <Setter Property="Fill" Value="#34D399"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding DeviceLabel}" FontSize="11" Margin="20,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>