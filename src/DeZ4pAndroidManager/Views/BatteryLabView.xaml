<UserControl x:Class="DeZ4pAndroidManager.Views.BatteryLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource BatteryLab.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource BatteryLab.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Big level ring -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24" Width="280">
                <StackPanel VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Center">
                        <Ellipse Width="180" Height="180" Fill="Transparent"
                                 Stroke="{DynamicResource BorderBrush}" StrokeThickness="14" Opacity="0.3"/>
                        <Ellipse Width="180" Height="180" Fill="Transparent"
                                 Stroke="{Binding Info.LevelColor}" StrokeThickness="14"
                                 StrokeDashArray="1 3"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Info.LevelDisplay}" FontSize="52" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding Info.LevelColor}"/>
                            <TextBlock Text="{Binding Info.Status}" FontSize="12" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Info.ChargeSource}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource BatteryLab.Source}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource BatteryLab.Details}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Health}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.Health}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Temp}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.TempDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="#F59E0B"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Voltage}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.VoltageDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="#22D3EE"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Current}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.CurrentDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="#A855F7"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Technology}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.Technology}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.HealthCalc}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.HealthPercent}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Capacity}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.CapacityDisplay}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Cycles}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.CycleDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="#EC4899"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.MaxCurrent}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}">
                                        <Run Text="{Binding Info.MaxChargingCurrentMa, Mode=OneWay}"/>
                                        <Run Text="mA"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.MaxVoltage}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}">
                                        <Run Text="{Binding Info.MaxChargingVoltageMv, Mode=OneWay}"/>
                                        <Run Text="mV"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryLab.Profile}" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding Info.PowerProfile}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding SaveReportCommand}" Tag="#4F8CFF"
                                        Style="{StaticResource ActionBarButton}" Padding="12,6" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#4F8CFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource BatteryLab.Save}" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenFolderCommand}" Tag="#F59E0B"
                                        Style="{StaticResource ActionBarButton}" Padding="10,6">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>