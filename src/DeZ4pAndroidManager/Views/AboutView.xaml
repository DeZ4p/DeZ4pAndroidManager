<UserControl x:Class="DeZ4pAndroidManager.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="900" HorizontalAlignment="Center">
            <StackPanel>

                <!-- Hero card -->
                <Border Style="{StaticResource Card}" Padding="32" Margin="0,0,0,14">
                    <StackPanel>
                        <Border Width="96" Height="96" CornerRadius="24"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F8CFF" Offset="0"/>
                                    <GradientStop Color="#7C5CFF" Offset="0.55"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFF" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="D" FontSize="56" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding AppName}" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,4" Margin="6,0,0,0">
                                <TextBlock Text="PRO" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Tagline}" FontSize="13" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" LineHeight="20" MaxWidth="640"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Developer card -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26"
                                Background="#224F8CFF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="24" Foreground="#4F8CFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DevelopedBy}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding ContactTelegram}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="#22D3EE"/>
                            <TextBlock Text="{Binding Copyright}" FontSize="10" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://t.me/DeZ4p"
                                Tag="#22D3EE" Style="{StaticResource ActionBarButton}"
                                Padding="14,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="#22D3EE" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Open Telegram" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Links -->
                <TextBlock Text="RESOURCES" FontSize="11" FontWeight="Bold" Margin="6,10,0,10"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="10"
                                    Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{Binding Color}"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Url}"
                                            Tag="#4F8CFF" Style="{StaticResource ActionBarButton}"
                                            Padding="10,6">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#4F8CFF"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Powered by ADB Â· scrcpy Â· .NET 8" FontSize="11" Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>