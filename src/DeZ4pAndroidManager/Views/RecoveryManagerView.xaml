<UserControl x:Class="DeZ4pAndroidManager.Views.RecoveryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Recovery.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Recovery.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="{Binding ModeColor}" CornerRadius="4" Padding="10,5"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ModeBadge}" FontSize="11" FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="220" Height="34"/>
                <Button Command="{Binding RefreshCommand}" Tag="#4F8CFF"
                        Style="{StaticResource ActionBarButton}" Padding="10,7" Margin="6,0,0,0">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4F8CFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Info banner -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets"
                           FontSize="20" Foreground="#22D3EE" Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{DynamicResource Recovery.InfoBanner}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Boot targets grid (clean, no icon boxes, white text, big) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BootTargets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="4" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="16,14"
                                                    Background="{DynamicResource CardHoverBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <!-- Big title -->
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <!-- Description -->
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11.5" Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <!-- Danger warning -->
                                                    <Border Margin="0,10,0,0" CornerRadius="3"
                                                            Background="#33EF4444"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="DANGEROUS" FontSize="9"
                                                                   FontWeight="Bold" Foreground="#EF4444"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=soft}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=med}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- History -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#F59E0B"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Recovery.HistoryHeader}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding ClearHistoryCommand}"
                                    HorizontalAlignment="Right"
                                    Tag="#EF4444" Style="{StaticResource ActionBarButton}"
                                    Padding="8,5">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#EF4444"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="3"
                                            Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ResultDisplay}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding ResultColor}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                                       MinWidth="32"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Target}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedForegroundBrush}">
                                                    <Run Text="{Binding Mode, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" FontSize="10" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" Foreground="#22D3EE"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>