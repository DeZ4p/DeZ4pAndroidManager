<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- â•â•â• Deep gradient background â•â•â• -->
    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0E1A" Offset="0"/>
        <GradientStop Color="#0F1424" Offset="0.5"/>
        <GradientStop Color="#0A0E1A" Offset="1"/>
    </LinearGradientBrush>

    <!-- â•â•â• Glass Cards (semi-transparent white overlay) â•â•â• -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SidebarBrush" Color="#CC0C1018"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#CC0A0E18"/>

    <SolidColorBrush x:Key="ForegroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#64748B"/>

    <!-- â•â•â• Accent â•â•â• -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F8CFF" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA0FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#22D3EE"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>

    <!-- â•â•â• Hero â•â•â• -->
    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#334F8CFF" Offset="0"/>
        <GradientStop Color="#227C5CFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroForegroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HeroSecondaryForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="HeroIconBackgroundBrush" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="HeroTrackBrush" Color="#22FFFFFF"/>

    <!-- â•â•â• Tinted cards (glass variants) â•â•â• -->
    <LinearGradientBrush x:Key="BatteryCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2634D399" Offset="0"/>
        <GradientStop Color="#0A34D399" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#4434D399"/>
    <SolidColorBrush x:Key="BatteryAccentBrush" Color="#34D399"/>

    <LinearGradientBrush x:Key="StorageCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26F59E0B" Offset="0"/>
        <GradientStop Color="#0AF59E0B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StorageBorderBrush" Color="#44F59E0B"/>
    <SolidColorBrush x:Key="StorageAccentBrush" Color="#F59E0B"/>

    <LinearGradientBrush x:Key="MemoryCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26A855F7" Offset="0"/>
        <GradientStop Color="#0AA855F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MemoryBorderBrush" Color="#44A855F7"/>
    <SolidColorBrush x:Key="MemoryAccentBrush" Color="#A855F7"/>

    <LinearGradientBrush x:Key="SystemCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#264F8CFF" Offset="0"/>
        <GradientStop Color="#0A4F8CFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SystemBorderBrush" Color="#444F8CFF"/>
    <SolidColorBrush x:Key="SystemAccentBrush" Color="#4F8CFF"/>

    <LinearGradientBrush x:Key="ActivityCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26EC4899" Offset="0"/>
        <GradientStop Color="#0AEC4899" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ActivityBorderBrush" Color="#44EC4899"/>
    <SolidColorBrush x:Key="ActivityAccentBrush" Color="#EC4899"/>

    <LinearGradientBrush x:Key="StatsCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A22D3EE" Offset="0"/>
        <GradientStop Color="#0A22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StatsBorderBrush" Color="#3322D3EE"/>
    <SolidColorBrush x:Key="StatsAccentBrush" Color="#22D3EE"/>

    <LinearGradientBrush x:Key="SecurityCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26EF4444" Offset="0"/>
        <GradientStop Color="#0AEF4444" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecurityBorderBrush" Color="#44EF4444"/>
    <SolidColorBrush x:Key="SecurityAccentBrush" Color="#EF4444"/>

    <LinearGradientBrush x:Key="NetworkCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2622D3EE" Offset="0"/>
        <GradientStop Color="#0A22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NetworkBorderBrush" Color="#4422D3EE"/>
    <SolidColorBrush x:Key="NetworkAccentBrush" Color="#22D3EE"/>

    <LinearGradientBrush x:Key="DisplayCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26818CF8" Offset="0"/>
        <GradientStop Color="#0A818CF8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DisplayBorderBrush" Color="#44818CF8"/>
    <SolidColorBrush x:Key="DisplayAccentBrush" Color="#818CF8"/>

    <LinearGradientBrush x:Key="CpuCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FBBF24" Offset="0"/>
        <GradientStop Color="#0AFBBF24" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CpuBorderBrush" Color="#44FBBF24"/>
    <SolidColorBrush x:Key="CpuAccentBrush" Color="#FBBF24"/>

</ResourceDictionary>